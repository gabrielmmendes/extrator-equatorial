# Copie para credenciais.env (que fica fora do git) e preencha.

# --- fila de UCs (API do Minha Fatura) ---------------------------------------
# Com a chave definida, a lista de UCs/documentos vem de GET /api/v1/queues e o
# contas.json deixa de ser necessario.
export MF_API_KEY=mf_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx
# export MF_API_URL=https://minha-fatura.vercel.app/api/v1
# export MF_API_LIMIT=50          # tarefas por busca (1-50)
# export MF_API_GRUPO=Sicoob      # filtra por grupo
# export MF_API_GRUPO_BUSCA=1     # filtra por grupo de leitura (1-3)
# export MF_FONTE=json            # forca a leitura do contas.json

# --- UC unica, so para o coletar.ps1 -----------------------------------------
# Use SOMENTE digitos - o proprio site aplica a mascara enquanto o script digita.
# export EQUATORIAL_UC=0000000000
# export EQUATORIAL_DOC=00000000000

# --- Google Drive (enviar_drive.py) ------------------------------------------
# Caminho do JSON de autorizacao. Service account (precisa de Shared Drive ou da
# pasta compartilhada como editor com o e-mail da conta) ou OAuth client, que
# abre o navegador uma vez e guarda o token em estado/drive_token.json.
export GOOGLE_DRIVE_CREDENCIAIS=C:\caminho\para\credencial-drive.json
# export GOOGLE_DRIVE_PASTA_ID=1vligcM_szlS_R9SUqq03StdG-HX6FAOX
